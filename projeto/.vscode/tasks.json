{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "projeto: default - Build",
            "detail": "Sombreia a task de build que a extensão MPLAB injeta ao detectar o projeto (.mplab.json). Ela rejeitaria o .asm; esta builda main.asm e o exemplo.",
            "type": "shell",
            "command": "make all exemplo",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build exemplo",
            "detail": "Builda exemplo/*.asm em build/*.elf",
            "type": "shell",
            "command": "make exemplo",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Upload para o Arduino",
            "type": "shell",
            "command": "make flash",
            "problemMatcher": []
        },
        {
            "label": "Upload serial-eco para o Arduino",
            "detail": "Grava o exemplo de eco serial; depois use o task 'Monitor serial' para conversar com ele",
            "type": "shell",
            "command": "make flash-eco",
            "problemMatcher": []
        },
        {
            "label": "Iniciar simavr (GDB server)",
            "type": "shell",
            "command": "make sim",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "aguardando GDB"
                }
            },
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Build + simavr",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build",
                "Iniciar simavr (GDB server)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Parar simavr",
            "type": "shell",
            "command": "pkill simavr || true",
            "problemMatcher": []
        },
        {
            "label": "Medir ciclos / tempo",
            "detail": "Cronômetro de ciclos no simulador: informe de onde até onde medir (rótulos do seu .asm)",
            "type": "shell",
            "command": "make ciclos DE=${input:rotuloDe} ATE=${input:rotuloAte}",
            "problemMatcher": []
        },
        {
            "label": "Listar rótulos do programa",
            "detail": "Mostra os rótulos e endereços disponíveis para medir",
            "type": "shell",
            "command": "make rotulos",
            "problemMatcher": []
        },
        {
            "label": "Terminal serial no simulador (serial-eco)",
            "detail": "USART0 do simulador ligada a este terminal: digite e veja a resposta. Ctrl+C sai.",
            "type": "shell",
            "command": "make serial",
            "presentation": {
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Monitor serial (placa via USB)",
            "detail": "Abre o picocom na porta do Arduino (Ctrl+A Ctrl+X para sair). Rode attach-arduino.ps1 no Windows antes.",
            "type": "shell",
            "command": "picocom -b 9600 ${input:portaSerial}",
            "problemMatcher": []
        },
        {
            "label": "Limpar (make clean)",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "rotuloDe",
            "type": "promptString",
            "description": "Medir a partir de qual rótulo? (vazio = desde o reset)",
            "default": ""
        },
        {
            "id": "rotuloAte",
            "type": "promptString",
            "description": "Medir até qual rótulo?",
            "default": "loopit"
        },
        {
            "id": "portaSerial",
            "type": "pickString",
            "description": "Porta serial do Arduino no WSL",
            "options": [
                "/dev/ttyACM0",
                "/dev/ttyUSB0"
            ],
            "default": "/dev/ttyACM0"
        }
    ]
}
